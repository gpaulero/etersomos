generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ReadingBooking {
  id             String    @id @default(cuid())
  name           String
  email          String
  phone          String
  readingType    String
  preferredDate  String?
  preferredTime  String?
  message        String?
  status         String    @default("pendiente")
  confirmedAt    DateTime?
  sentAt         DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CrystalOrder {
  id             String    @id @default(cuid())
  customerName   String
  customerEmail  String
  customerPhone  String
  address        String
  city           String
  province       String
  postalCode     String
  notes          String?
  items          String    // JSON array of {id, name, quantity, price}
  total          Float
  paymentMethod  String    // "paypal" or "mercadopago"
  paymentId      String?
  status         String    @default("pendiente") // pendiente, pagado, enviado, cancelado
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
